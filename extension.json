{
	"name": "BilupBlocks",
	"author": [
		"ErnieParke",
		"blob8108",
		"apple502j",
		"kenny2github",
		"Bilup"
	],
	"url": "https://github.com/Bilup/BilupWikiBlocks",
	"descriptionmsg": "sb3-desc",
	"license-name": "MIT",
	"type": "parserhook",
	"AutoloadClasses": {
		"BilupBlockHook": "BilupblockHooks.php"
	},
	"ResourceModules": {
		"ext.BilupBlocks": {
			"scripts": [
				"run_BilupBlocks.js"
			],
			"styles": "/inline.css",
			"dependencies": [
				"ext.BilupBlocks.sb",
				"ext.BilupBlocks.translations"
			]
		},
		"ext.BilupBlocks.sb": {
			"scripts": [
				"lib/bilupblocks.min.js"
			]
		},
		"ext.BilupBlocks.translations": {
			"scripts": [
				"lib/translations-all.js"
			],
			"dependencies": [
				"ext.BilupBlocks.sb"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "mw-BilupBlocks"
	},
	"Hooks": {
		"ParserFirstCallInit": "main",
		"ResourceLoaderGetConfigVars": "main"
	},
	"HookHandlers": {
		"main": {
			"class": "BilupBlockHook"
		}
	},
	"MessagesDirs": {
		"BilupBlocks": [
			"i18n"
		]
	},
	"config": {
		"BilupBlocksLangs": {
			"value": []
		},
		"BilupBlocksBlockVersion": {
			"value": "3.0"
		}
	},
	"manifest_version": 2,
	"requires": {
		"MediaWiki": ">= 1.35.0"
	}
}
